{
  "name": "sideband-audio-broadcast-workbench",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "displayName": "SIDEBAND — Audio Broadcast Workbench",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/sideband-*.test.mjs",
    "verify": "npm test",
    "fixtures": "node scripts/generate-audio-fixtures.js",
    "dev": "npm run dev:cloudflare",
    "dev:cloudflare": "wrangler dev --config wrangler.jsonc --local",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "ensure:cloudflare": "node scripts/ensure-cloudflare-config.mjs",
    "configure:access": "node scripts/configure-access.mjs",
    "deploy": "npm run verify && npm run ensure:cloudflare && npm run migrate:remote && npm run deploy:cloudflare && npm run verify:live",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "verify:live": "node scripts/verify-live.mjs",
    "migrate:local": "wrangler d1 migrations apply sideband --local --config wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply sideband --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
