{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sideband-audio-broadcast-workbench",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "greenshoegarage.com/radio*",
      "zone_name": "greenshoegarage.com"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sideband",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sideband-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STATION_STATE", "class_name": "StationStateDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StationStateDurableObject"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_PATH": "/radio"
  },
  "triggers": { "crons": ["* * * * *"] }
}
